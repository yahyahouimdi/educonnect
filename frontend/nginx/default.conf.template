# Served by the official nginx image: variables such as ${BACKEND_URL} are substituted from the
# environment at container start (see /docker-entrypoint.d/20-envsubst-on-templates.sh).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Requests whose Origin host matches the Host header are same-origin by construction (the SPA and
# the API share this server), so the Origin header is dropped before proxying. Otherwise the backend
# would compare it with its own view of the URL, which differs behind proxies (ports, TLS), and
# reject legitimate calls as cross-origin. Genuine cross-origin requests keep their Origin and stay
# subject to the backend's CORS rules. Authentication uses bearer tokens, not cookies.
map "$http_origin|$http_host" $proxied_origin {
    "~^https?://([^|/]+)\|\1$" "";
    default $http_origin;
}

# Keep the original scheme when another TLS-terminating proxy sits in front of this one.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size ${UPLOAD_MAX_BODY_SIZE};
    server_tokens off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # REST API and OpenAPI documentation
    location ^~ /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Origin $proxied_origin;
        proxy_read_timeout 120s;
    }

    # Real-time chat (STOMP over WebSocket)
    location ^~ /ws {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Origin $proxied_origin;
        proxy_read_timeout 1h;
    }

    # Fingerprinted build assets can be cached forever.
    location ~* \.(?:js|css|woff2?|ttf|eot)$ {
        expires 1y;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Single-page application: unknown paths are handled by the Angular router.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
