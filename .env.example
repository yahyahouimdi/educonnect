# -----------------------------------------------------------------------------------------------
# EduConnect configuration. Copy to `.env` and adjust:  cp .env.example .env
# Every variable is optional for a local trial; CHANGE THE SECRETS before going to production.
# -----------------------------------------------------------------------------------------------

# Port on which the website is served (http://localhost:APP_PORT)
APP_PORT=8080

# ---- Your institution (initial values; editable later in Admin → Settings) ---------------------
INSTITUTION_NAME=EduConnect Academy
INSTITUTION_SHORT_NAME=EduConnect
INSTITUTION_TAGLINE=Learn. Connect. Grow.
INSTITUTION_EMAIL=contact@educonnect.local
INSTITUTION_PHONE=+000 00 000 000
INSTITUTION_ADDRESS=1 Campus Avenue, Your City
INSTITUTION_PRIMARY_COLOR="#1d4ed8"

# ---- First administrator account (created on first start only) ---------------------------------
ADMIN_EMAIL=admin@educonnect.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Platform Administrator

# Seed a demo teacher, student, courses and news on an empty database (set to false in production)
DEMO_DATA=true

# ---- Security ----------------------------------------------------------------------------------
# Generate one with:  openssl rand -base64 64
JWT_SECRET=change-me-this-is-a-development-only-secret-of-at-least-64-characters!!
# Session lifetime (ISO-8601 duration)
JWT_EXPIRATION=PT12H
# Only needed when the frontend is served from another origin (e.g. `ng serve` on :4200)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- Database ----------------------------------------------------------------------------------
DB_NAME=educonnect
DB_USERNAME=educonnect
DB_PASSWORD=educonnect
DB_ROOT_PASSWORD=educonnect-root

# ---- Uploads -----------------------------------------------------------------------------------
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_BODY_SIZE=50m

# ---- AI teaching assistant (optional) ----------------------------------------------------------
# Google Gemini API key from https://aistudio.google.com/apikey. Leave empty to disable the assistant.
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# ---- Pre-built images (optional) ---------------------------------------------------------------
# To run images published by CI instead of building locally, e.g. IMAGE_REGISTRY=ghcr.io/<owner>
IMAGE_REGISTRY=educonnect
IMAGE_TAG=latest
